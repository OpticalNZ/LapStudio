# ── Build artefacts ─────────────────────────────────────────────────────────
build/
dist/
# (make_release.bat is versioned; its output in dist/ is not)
*.spec.bak
__pycache__/
*.py[cod]
*.egg-info/

# ── Working backups and scratch ─────────────────────────────────────────────
*.bak
*.bak_*
_backup_root_*/
ui_prefs.json
geometry.json
panel_geometry.json
pill_clean.npy

# ── Telemetry logs: never commit. These are session data, often belonging to
#    other drivers/teams, and some are large. Keep them out of the repo.
*.csv
*.vbo
*.drk
*.xrk
*.xrz
*.dat
*.gpk
*.rrk

# ── Video and rendered output ───────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.sfk
preview_*.png
_tm.png
dash*_*.png
# ...but these two are runtime assets for the HUD dashes, not screenshots:
!dash_hud_bg.png
!dash_hud2_bg.png
lap*_*.png
tm*_*.png
crop_*.png
jit_*.png

# ── Third-party binaries. Not ours to redistribute; users install these
#    themselves (see the README).
#    ffmpeg (GPL/LGPL, ~250 MB), the AiM XRK library, and MSVC runtimes.
bin/
ffmpeg.exe
ffplay.exe
ffprobe.exe
av*.dll
sw*.dll
postproc*.dll
MatLabXRK*.dll
libxml2*.dll
libiconv*.dll
libz.dll
msvcr*.dll
pthreadVC*.dll

# ── Not part of this project ───────────────────────────────────────────────
# Firm/work documents that have found their way into the folder. Never publish.
IS-manual-*.md
py lines.txt
.ecu_theme

# Distribution zips are rebuilt on demand, not versioned.
LapStudio-*.zip

# ── Editor / OS noise ──────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Telemetry logs. These are customers' session data and must never be published.
*.ld
*.ldx
*.drk
*.xrk
*.xrz
*.vbo
motec_preview_check.png

# PyInstaller regenerates this on every build, so it only ever churns.
gopro-dashboard-overlay-main.zip

# PyInstaller rewrites this on every build; it only ever churns a diff.
*.spec
trackmap_modes.png
